# Ambiente
NODE_ENV=development
PORT=3333

# MongoDB
MONGODB_URI=mongodb://localhost:27017/chamados-ti

# JWT — gere com `openssl rand -base64 48` (mínimo 32 caracteres, nunca reuse entre ambientes)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# CORS - origem exata do front-end (sem "*", nunca em produção)
CORS_ORIGIN=http://localhost:3000

# Rate limit das rotas de autenticação
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# SMTP — opcional. Sem SMTP_HOST/SMTP_USER/SMTP_PASS, as notificações por
# e-mail em mudança de status ficam desativadas (log de aviso, sem falhar).
# Para testar localmente sem um servidor SMTP real, crie uma conta grátis
# em https://ethereal.email (inbox falsa, e-mails não saem de verdade).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
